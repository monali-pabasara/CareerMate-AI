<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/privacySecurityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="135dp"
        android:background="#185FA5"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Privacy &amp; Security"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="How CareerMate AI protects user data"
            android:textColor="#D6E8FA"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACCOUNT PROTECTION"
                android:textColor="#8FA5C0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/dashboard_card_bg"
                android:lineSpacingExtra="5dp"
                android:padding="16dp"
                android:text="CareerMate AI uses secure login to protect student accounts. Users must sign in before accessing their career profile, dashboard, CV feedback, portfolio details and progress data."
                android:textColor="#1A1A2E"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="USER-SPECIFIC DATA ACCESS"
                android:textColor="#8FA5C0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/dashboard_card_bg"
                android:lineSpacingExtra="5dp"
                android:padding="16dp"
                android:text="Each user’s profile, CV feedback, portfolio details and progress data are linked to their own user account. This helps make sure students can access only their own data."
                android:textColor="#1A1A2E"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="LOCAL CACHE"
                android:textColor="#8FA5C0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/dashboard_card_bg"
                android:lineSpacingExtra="5dp"
                android:padding="16dp"
                android:text="The app may store some information locally as temporary cache to improve the user experience. This local cache is cleared when the user logs out."
                android:textColor="#1A1A2E"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="CAREER GUIDANCE NOTE"
                android:textColor="#8FA5C0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/dashboard_card_bg"
                android:lineSpacingExtra="5dp"
                android:padding="16dp"
                android:text="CV feedback, skill gap results, interview practice feedback and job role suggestions are used for career preparation guidance only. CareerMate AI does not guarantee employment."
                android:textColor="#1A1A2E"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/backToSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/outline_button_bg"
                android:text="Back to Settings"
                android:textAllCaps="false"
                android:textColor="#185FA5"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>