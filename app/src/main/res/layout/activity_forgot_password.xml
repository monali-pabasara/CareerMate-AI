<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/forgotPasswordScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="34dp"
        android:paddingEnd="30dp"
        android:paddingBottom="34dp">

        <ImageView
            android:id="@+id/forgotLogo"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:contentDescription="CareerMate AI Logo"
            android:src="@drawable/splashicon" />

        <TextView
            android:id="@+id/forgotTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Forgot Password?"
            android:textColor="#1A1A2E"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/forgotSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="Enter your registered email address and we will help you reset your password."
            android:textColor="#6B8CAE"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resetEmailLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:text="Email"
            android:textColor="#6B8CAE"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/resetEmailInput"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_background"
            android:hint="Enter your registered email"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#1A1A2E"
            android:textColorHint="#8FA5C0"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/sendResetButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/login_button_blue"
            android:text="Send Reset Link"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/backToLoginText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Back to Login"
            android:textColor="#185FA5"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>