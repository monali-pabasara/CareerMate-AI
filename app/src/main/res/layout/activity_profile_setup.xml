<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileSetupScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="34dp"
        android:paddingEnd="26dp"
        android:paddingBottom="34dp">

        <TextView
            android:id="@+id/profileSetupTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Up Your Profile"
            android:textColor="#1A1A2E"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profileSetupSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Tell us about your studies, skills and career goal so CareerMate AI can calculate your career readiness."
            android:textColor="#6B8CAE"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Full Name"
            android:textColor="#6B8CAE"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/profileFullNameInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_background"
            android:hint="Enter your full name"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#1A1A2E"
            android:textColorHint="#8FA5C0"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Degree Programme"
            android:textColor="#6B8CAE"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/degreeProgrammeSpinner"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Academic Year"
            android:textColor="#6B8CAE"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/academicYearSpinner"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Target Career Role"
            android:textColor="#6B8CAE"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/targetRoleSpinner"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:spinnerMode="dropdown" />

        <TextView
            android:id="@+id/currentSkillsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Current Skills"
            android:textColor="#6B8CAE"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/skillsInstructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select a target career role to view related skills."
            android:textColor="#8FA5C0"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/skillCheckBox1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#185FA5"
            android:textColor="#1A1A2E"
            android:textSize="14sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/skillCheckBox2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#185FA5"
            android:textColor="#1A1A2E"
            android:textSize="14sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/skillCheckBox3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#185FA5"
            android:textColor="#1A1A2E"
            android:textSize="14sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/skillCheckBox4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#185FA5"
            android:textColor="#1A1A2E"
            android:textSize="14sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/skillCheckBox5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#185FA5"
            android:textColor="#1A1A2E"
            android:textSize="14sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/skillCheckBox6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#185FA5"
            android:textColor="#1A1A2E"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Career Goal"
            android:textColor="#6B8CAE"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/careerGoalInput"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_background"
            android:gravity="top"
            android:hint="Example: I want to improve my career skills and prepare for graduate jobs."
            android:inputType="textMultiLine"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:textColor="#1A1A2E"
            android:textColorHint="#8FA5C0"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/saveProfileButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/login_button_blue"
            android:text="Save and Continue"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/login_button_blue"
            android:backgroundTint="#EF3B35"
            android:text="Log out"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="CareerMate AI © 2026 v1.0"
            android:textColor="#B8C4D4"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>